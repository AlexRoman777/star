STAR_CONTROL_PLANE_URL=http://192.168.0.10:3822
# Pause at or below 20%, recharge to 50%, then resume at full cadence on AC.
STAR_MAC_MINIMUM_BATTERY=50
STAR_MAC_BATTERY_RESUME_PERCENT=50
STAR_MAC_MODEL_COOLDOWN_SECONDS=0
# Bearer token for the native Apple power/host-load service (port 8769).
# Synchronized by `tools/star deploy apple` from
# ~/Library/Application Support/Star/apple-power-token; leave empty here.
STAR_APPLE_POWER_TOKEN=

STAR_ACCELERATOR_WORKER_HOSTNAME=apple-deep-review
STAR_MODEL_WORKER_CPU_LIMIT=4.0
STAR_MODEL_WORKER_MEMORY_LIMIT=16g
STAR_MODEL_WORKER_MEMORY_RESERVATION=4g
STAR_MAC_PRIMARY_MODEL=ministral-3:8b-instruct-2512-q4_K_M
STAR_MAC_ASSIST_MODEL_KEYS=qwen3-vl:8b-instruct-q4_K_M,qwen3.8:27b,qwen3.5:27b
STAR_ADVISER_MODEL_API_KEY=replace-with-the-token-created-by-install-qwen38-mlx.sh
STAR_MLX_ADVISER_RUNTIME_MODEL=/Users/Shared/Star/model-archives/Qwen3.8-27B-active
# SHA-256 over config.json + model.safetensors.index.json + .star-source.json of the
# active archive. install-qwen38-mlx.sh records it here; the coordinator enables
# the MLX registration only when the worker reports it.
STAR_MLX_ADVISER_ARTIFACT_CHECKSUM=
# Six lanes are allowed only for the exact canonical Ministral helper model.
# Qwen, MLX 27B owner sessions, and every other model remain on the first lane.
STAR_MAC_MODEL_CONCURRENCY=6
STAR_MAC_PARALLEL_MODEL_KEY=ministral-3:8b-instruct-2512-q4_K_M
STAR_MAC_PARALLEL_MODEL_LANES=ministral-3:8b-instruct-2512-q4_K_M=6,qwen3-vl:8b-instruct-q4_K_M=4
STAR_MAC_MODEL_KEEP_ALIVE=30s
STAR_MAC_MODEL_IDLE_TTL_SECONDS=30
