# Copy to .env in this directory and fill in. This file is ignored by Git.

# The address of this machine on your home network. The web UI and the workers reach
# the coordinator at http://<this address>:3822. Leave it out to listen on 127.0.0.1 only.
STAR_LAN_ADDRESS=192.168.0.10
# Workers that connect from these networks may enrol themselves. Set it to your own LAN.
STAR_WORKER_AUTO_ENROLL_CIDRS=192.168.0.0/24
# A name for this machine, shown on the Machines page.
STAR_COORDINATOR_NAME=star-coordinator
# Where the database, artifacts and backups live on this host.
STAR_DATA_DIR=./star-data

# Secrets. Generate each one; never reuse a value.
#   openssl rand -hex 32        for the tokens
#   openssl rand -base64 48     for the session secret
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   for the encryption key
STAR_AGENT_DIAGNOSTICS_TOKEN=CHANGE_ME_RANDOM_HEX_32_BYTES
STAR_AGENT_OPERATIONS_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_HEX_32_BYTES
STAR_BOOTSTRAP_TOKEN=CHANGE_ME_RANDOM_HEX_32_BYTES
STAR_ENCRYPTION_KEY=CHANGE_ME_URLSAFE_BASE64_32_BYTES
STAR_SEARCH_EMBEDDING_TOKEN=CHANGE_ME_MATCHES_NVIDIA_EMBEDDING_TOKEN
STAR_SESSION_SECRET=CHANGE_ME_RANDOM_BASE64_48_BYTES
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD

