STAR_CONTROL_PLANE_URL=http://192.168.0.10:3822
STAR_WORKER_HOSTNAME=nvidia-technical
# Sizes the cpu-light lanes (media staging + similarity embedding) of the technical-worker container.
STAR_TECHNICAL_CONCURRENCY=4
STAR_TECHNICAL_CPU_LIMIT=3.5
STAR_TECHNICAL_MEMORY_LIMIT=24g
STAR_TECHNICAL_MEMORY_RESERVATION=8g

STAR_REVIEW_WORKER_HOSTNAME=nvidia-photo-review
STAR_REVIEW_WORKER_CPU_LIMIT=3.0
STAR_REVIEW_WORKER_MEMORY_LIMIT=24g
STAR_REVIEW_WORKER_MEMORY_RESERVATION=8g
STAR_NVIDIA_QUIET_START=22:00
STAR_NVIDIA_QUIET_END=07:00
STAR_NVIDIA_QUIET_TIMEZONE=Europe/Stockholm
# During quiet hours the worker matches rest time to measured completed work,
# producing an approximately 50% wall-clock duty cycle without privileged GPU
# controls. This optional value is an additional minimum rest.
STAR_NVIDIA_QUIET_PERFORMANCE_PERCENT=50
STAR_NVIDIA_QUIET_COOLDOWN_SECONDS=0

# Benchmark-selected primary photo-review model.
STAR_OLLAMA_MODEL_KEYS=ministral-3:8b-instruct-2512-q4_K_M
STAR_OLLAMA_HIGHLIGHT_MODEL=qwen3-vl:8b-instruct-q4_K_M
STAR_OLLAMA_CONTEXT_LENGTH=4096
STAR_OLLAMA_KEEP_ALIVE=30m
STAR_OLLAMA_MODEL_IDLE_TTL_SECONDS=30
STAR_OLLAMA_MAX_QUEUE=16
STAR_OLLAMA_CPU_LIMIT=7.5
STAR_OLLAMA_MEMORY_LIMIT=48g
STAR_OLLAMA_MEMORY_RESERVATION=24g

# Similarity EmbeddingRuntime (DINOv2 only since v209): the NVIDIA worker
# reaches it on the compose network, so it does not need a LAN bind.
STAR_EMBEDDING_TOKEN=CHANGE_ME_LOCAL_EMBEDDING_TOKEN

# Senior (Advanced) reviews on the NVIDIA worker: Ternary Bonsai 2 27B served by
# PrismML's llama.cpp fork from STAR_BONSAI_DIR (the fork build under
# llama.cpp/build/bin plus the two .gguf files).
STAR_NVIDIA_SENIOR_MODEL_KEY=qwen3.8:27b
STAR_BONSAI_DIR=/opt/star/bonsai
STAR_BONSAI_CONTEXT_TOKENS=6144
STAR_BONSAI_MEMORY_LIMIT=16g
# sha256 of Ternary-Bonsai-2-27B-PTQ1_0.gguf (sha256sum in STAR_BONSAI_DIR). The
# worker reports it with its model inventory and the NAS enables the NVIDIA worker's
# senior registration automatically; without it the registration stays disabled
# and the NVIDIA worker does primary reviews only.
# Leave empty unless you built the fork and start the "advanced-review" profile.
STAR_BONSAI_ARTIFACT_CHECKSUM=
# COMPOSE_PROFILES=advanced-review
